# Read by Cloudflare's static asset server, never served itself.
#
# Everything under /_next/static has a content hash in its name: a changed file gets a new
# name, so the old one can be kept for good. Cloudflare's default for assets is
# "max-age=0, must-revalidate", which made every page view re-ask the server about 20-30
# scripts, stylesheets and fonts it already had - one round trip each.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
